# =============================================================================
# .env.example  —  template for the stack's configuration.
#
# HOW TO USE:
#   cp .env.example .env      # then fill in REAL values in .env
#
# .env is GITIGNORED and must NEVER be committed. This .example file ships
# only safe placeholders so a fresh clone knows which variables exist.
#
# NOTE: Application credentials (the 4 email accounts, Telegram/WhatsApp,
# Notion, and the CLAUDE API KEY) are NOT here. Those are entered in the n8n
# UI and stored encrypted in Postgres. They never touch the repo OR this file.
# =============================================================================

# --- Timezone -----------------------------------------------------------------
# Drives n8n's cron, including the Chief of Staff 05:30 brief. Use a tz name.
# Examples: America/New_York, Europe/London, Asia/Singapore
TZ=America/New_York

# --- Public hostname ----------------------------------------------------------
# PRODUCTION : your real domain, DNS pointed at the VPS  -> Let's Encrypt cert.
# LOCAL DEV  : use n8n.localhost                          -> Caddy internal cert.
N8N_HOST=n8n.localhost

# --- Let's Encrypt contact email (production only) ----------------------------
# Used for cert-expiry notices. Ignored for *.localhost local dev.
ACME_EMAIL=you@example.com

# --- PostgreSQL ---------------------------------------------------------------
# The DB credentials n8n uses. Make the password long and random in real .env:
#   openssl rand -base64 24
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=n8n

# --- n8n credential encryption key --------------------------------------------
# Encrypts all stored credentials at rest. Generate ONCE and keep it forever
# (back it up somewhere safe). If it changes, saved credentials break.
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32

# --- Deploy target (used by `make deploy`) ------------------------------------
# Your VPS as reached over Tailscale. Can be a Tailscale MagicDNS name or IP,
# and the ssh user. The repo is pulled + the stack restarted over SSH.
VPS_SSH=ubuntu@your-vps.tailnet-name.ts.net
VPS_PATH=~/agents
